# Simulation for tb.json. Generated by uvm-zero-generate; edit freely. It is
# replaced only by uvm-zero-generate --refresh-infra.
#
#   make                       run the first test in simulation.tests of tb.json
#   make <test>                run one test by its name in simulation.tests
#   make TB_TEST=<test>        the same, through the variable
#   make tests                 run every test, one simulation and results file each
#   make SIM=icarus            use another simulator
#   make generate              check tb.json and write missing classes

PYTHON ?= python
SIM ?= verilator
TOPLEVEL_LANG ?= verilog
COCOTB_TOPLEVEL ?= axi_xbar_lint
VERILOG_SOURCES ?= $(CURDIR)/../rtl/axi_demo_cfg_pkg.sv $(CURDIR)/../rtl/axi_xbar_lint.sv
COMPILE_ARGS += -F ../rtl/files.f --assert -Wno-fatal

COCOTB_TEST_MODULES ?= uvm_zero_base.test
TB_CONFIG ?= $(CURDIR)/tb.json
# TB_TEST names a test; left empty, the first one in simulation.tests runs.
# The generated classes are imported from this directory.
export PYTHONPATH := $(CURDIR):$(PYTHONPATH)

ifeq ($(filter generate,$(MAKECMDGOALS)),)
ifeq ($(strip $(COCOTB_TOPLEVEL)$(VERILOG_SOURCES)),)
$(error Add "simulation": {"toplevel": ..., "sources": [...]} to tb.json and run uvm-zero-generate --refresh-infra)
endif
endif

UVM_ZERO_ROOT ?= $(shell $(PYTHON) -c "import pathlib, uvm_zero_base; print(pathlib.Path(uvm_zero_base.__file__).parent)")
include $(UVM_ZERO_ROOT)/makefiles/sim.mk

# One simulation per test, each with its own results file. The names come from
# simulation.tests in the config each time make runs, so adding or renaming a test
# needs no Makefile change. These follow the include, so "sim" stays the default goal.
TESTS := $(shell $(PYTHON) -c 'import json, sys; print(" ".join(json.load(open(sys.argv[1])).get("simulation", {}).get("tests", {})))' $(TB_CONFIG))
.PHONY: tests $(TESTS)
ifneq ($(strip $(TESTS)),)
$(TESTS):
	$(MAKE) sim TB_TEST=$@ COCOTB_RESULTS_FILE=results_$@.xml
endif
tests:
	@status=0; for test in $(TESTS); do \
		$(MAKE) sim TB_TEST=$$test COCOTB_RESULTS_FILE=results_$$test.xml || status=1; \
	done; exit $$status
# cocotb's clean removes results.xml; the per-test results files are removed here.
clean::
	@rm -f results_*.xml
