# Simulation for ${config_name}. Generated by uvm-zero-generate; edit freely. It is
# replaced only by uvm-zero-generate --refresh-infra.
#
#   make                       run the first test in simulation.tests of ${config_name}
#   make <test>                run one test by its name in simulation.tests
#   make TB_TEST=<test>        the same, through the variable
#   make tests                 run every test, one simulation and results file each
#   make SIM=icarus            use another simulator
#   make generate              check ${config_name} and write missing classes

PYTHON ?= python
SIM ?= ${simulator}
TOPLEVEL_LANG ?= verilog
COCOTB_TOPLEVEL ?= ${toplevel}
VERILOG_SOURCES ?= ${sources}
${build_options}
COCOTB_TEST_MODULES ?= uvm_zero_base.test
TB_CONFIG ?= $$(CURDIR)/${config_name}
# TB_TEST names a test; left empty, the first one in simulation.tests runs.
# The generated classes are imported from this directory.
export PYTHONPATH := $$(CURDIR):$$(PYTHONPATH)

ifeq ($$(filter generate,$$(MAKECMDGOALS)),)
ifeq ($$(strip $$(COCOTB_TOPLEVEL)$$(VERILOG_SOURCES)),)
$$(error Add "simulation": {"toplevel": ..., "sources": [...]} to ${config_name} and run uvm-zero-generate --refresh-infra)
endif
endif

UVM_ZERO_ROOT ?= $$(shell $$(PYTHON) -c "import pathlib, uvm_zero_base; print(pathlib.Path(uvm_zero_base.__file__).parent)")
include $$(UVM_ZERO_ROOT)/makefiles/sim.mk
${test_targets}